<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISOS PARA INTERNET Y ESTADO DE RED -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodMusic"
        android:usesCleartextTraffic="true">

        <!-- Pantalla de inicio -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MoodMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".ui.auth.InicioSesionActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Registro -->
        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Selección de Avatar -->
        <activity
            android:name=".ui.avatar.SeleccionAvatarActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Estado de Ánimo -->
        <activity
            android:name=".ui.registro_estado.EstadoAnimoActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Registrar Estado -->
        <activity
            android:name=".ui.registro_estado.RegistrarEstadoActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Historial -->
        <activity
            android:name=".ui.historial.HistorialActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <!-- Detalle Historial -->
        <activity
            android:name=".ui.historial.DetalleHistorialActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <activity
            android:name=".ui.musica.MusicaRecomendadaActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <activity
            android:name=".ui.perfil.EditarPerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <activity
            android:name=".ui.perfil.CambiarContrasenaActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

        <activity
            android:name=".ui.musica.CargaMusicaActivity"
            android:exported="false"
            android:theme="@style/Theme.MoodMusic" />

    </application>

</manifest>